<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeBarWin</AssemblyName>
    <RootNamespace>ClaudeBarWin</RootNamespace>
    <Version>0.3.9</Version>
    <Product>ClaudeBar for Windows</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Single-file publish friendly -->
    <SelfContained>false</SelfContained>
    <!-- NETSDK1187: NetSparkleUpdater.UI.WinForms.NetCore 3.1.0 empaqueta su recurso japonés con la
         locale "JA" (mayúsculas) y el SDK avisa al normalizarla a "ja". Es un bug del PAQUETE (no
         nuestro, reportado upstream en NetSparkle); se silencia hasta que publiquen el fix. -->
    <NoWarn>$(NoWarn);NETSDK1187</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />
    <PackageReference Include="NetSparkleUpdater.UI.WinForms.NetCore" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeBarWin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hooks\claudebar-hook.ps1" />
    <!-- T13b: snapshot de tarifas (models.dev, provider anthropic) — respaldo offline del catálogo. -->
    <EmbeddedResource Include="Resources\models-pricing-snapshot.json" />
  </ItemGroup>

  <!-- The test project lives in a subfolder; exclude it from the root project's default glob. -->
  <ItemGroup>
    <Compile Remove="ClaudeBarWin.Tests\**\*.cs" />
    <EmbeddedResource Remove="ClaudeBarWin.Tests\**" />
    <None Remove="ClaudeBarWin.Tests\**" />
  </ItemGroup>

</Project>
