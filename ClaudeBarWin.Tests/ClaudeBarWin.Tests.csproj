<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- NETSDK1187: locale "JA" mal escrita dentro del paquete NetSparkleUpdater.UI.WinForms.NetCore
         (llega transitivo por la referencia al proyecto principal). Bug del paquete; silenciado. -->
    <NoWarn>$(NoWarn);NETSDK1187</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeBarWin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImplicitUsings no inyecta Xunit con net9.0-windows; lo hacemos global para todos los tests. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- T13b: golden file con la respuesta real de models.dev para los tests del catálogo. -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
